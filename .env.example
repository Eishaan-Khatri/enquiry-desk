# Copy this file to .env and fill it in. The .env file is ignored by git.
# Every setting and its default is in src/enquiry_desk/config.py.

# ---- The model. Any server that speaks the OpenAI Chat Completions format. ----
#   Local, free  http://localhost:11434/v1        (docker compose up -d ollama)
#   OpenAI       https://api.openai.com/v1
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter   https://openrouter.ai/api/v1
DESK_LLM_BASE_URL=http://localhost:11434/v1
DESK_LLM_API_KEY=local
DESK_LLM_MODEL=qwen2.5:3b
# Seconds to wait for the next chunk. A model on a laptop CPU needs minutes. An API needs 60.
DESK_LLM_TIMEOUT_S=600
# Set to false if the server rejects stream_options. Token counts will then be missing.
DESK_LLM_STREAM_USAGE=true
# true: the code searches before every model call. false: the model decides when to search.
DESK_ALWAYS_SEARCH_FIRST=false
DESK_SESSION_COST_CAP_USD=0.50

# ---- Search ----
# The Qdrant server from compose.yml. Leave empty to use the embedded store under var/.
DESK_QDRANT_URL=http://localhost:6333
# "fastembed" downloads about 70 MB on first use. "hash" is for tests only: words, not meaning.
DESK_EMBEDDER=fastembed

# ---- Storage ----
# Empty keeps everything in SQLite files under var/. A postgresql:// address moves the tables
# and the conversation checkpoints to PostgreSQL. That mode needs Linux (the container is).
DESK_DATABASE_URL=

# ---- CRM ----
# "local" keeps leads in the desk's own database. "hubspot" needs a private app token.
DESK_CRM=local
DESK_HUBSPOT_TOKEN=
DESK_HUBSPOT_CLIENT_SECRET=

# ---- Webhooks ----
# The secret a website uses to sign the leads it posts to /webhooks/lead.
DESK_WEBHOOK_SECRET=
# When set, the operator endpoint requires it in the X-Desk-Secret header.
DESK_OPERATOR_SECRET=
# A Slack or Discord incoming-webhook URL that gets an alert on a handoff or a hot lead.
DESK_NOTIFY_URL=
DESK_NOTIFY_SECRET=
# The address the outside world reaches this server at. HubSpot and Twilio sign the URL they called.
DESK_PUBLIC_BASE_URL=http://localhost:8000

# ---- Voice ----
DESK_VOICE_STT_MODEL=base
# "en" or "hi" pins the language. Empty lets the model detect it.
DESK_VOICE_LANGUAGE=
DESK_VOICE_SILENCE_MS=700
DESK_TWILIO_AUTH_TOKEN=

# ---- Monitoring ----
# Where to send traces. Empty sends none. Jaeger from compose.yml listens here:
# DESK_OTLP_ENDPOINT=http://localhost:4318/v1/traces
DESK_OTLP_ENDPOINT=
DESK_LOG_JSON=false
